{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@moneymate/contracts": ["../../packages/contracts/src"],
      "@moneymate/api-core": ["../../packages/api-core/src"],
      "@moneymate/design-tokens": ["../../packages/design-tokens/src"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
