{
  "expo": {
    "name": "MoneyMate",
    "slug": "moneymate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moneymate",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "vn.moneymate.app",
      "associatedDomains": [
        "applinks:app.moneymate.vn"
      ],
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "vn.moneymate.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.moneymate.vn",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Cho phép MoneyMate sử dụng Face ID để bảo vệ dữ liệu tài chính."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Cho phép MoneyMate sử dụng Face ID để mở khóa ứng dụng."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép MoneyMate dùng camera để quét hóa đơn."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép MoneyMate chọn ảnh hóa đơn."
        }
      ],
      "expo-notifications",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "autolinkingModuleResolution": true,
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
