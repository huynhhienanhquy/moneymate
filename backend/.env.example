PORT=5000
DATABASE_URL=mysql://root:password@localhost:3306/moneymate
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
NODE_ENV=development
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173,http://10.10.10.183:5173

# Attachment storage: local for development, s3 for production
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# Optional AI features
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=1500

# CopilotKit v2 runtime (disabled by default)
COPILOTKIT_ENABLED=false
COPILOT_MODEL=openai/gpt-4o-mini
COPILOT_MAX_STEPS=3
COPILOT_MAX_OUTPUT_TOKENS=1500
COPILOT_MAX_MESSAGE_CHARS=4000
COPILOT_MODEL_TIMEOUT_MS=45000
COPILOT_RATE_LIMIT_MAX_REQUESTS=60
COPILOT_RATE_LIMIT_WINDOW_MS=60000
COPILOTKIT_TELEMETRY_DISABLED=true
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_REGISTER_RATE_LIMIT_WINDOW_MS=3600000
