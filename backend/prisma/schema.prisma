datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  passwordHash            String
  fullName                String
  avatarUrl               String?
  role                    Role                     @default(USER)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  wallets                 Wallet[]
  categories              Category[]
  transactions            Transaction[]
  budgets                 Budget[]
  savingGoals             SavingGoal[]
  recurringTransactions   RecurringTransaction[]
  notifications           Notification[]
  refreshTokens           RefreshToken[]
  walletTransfers         WalletTransfer[]
  monthlySavingsSnapshots MonthlySavingsSnapshot[]
  deviceTokens            DeviceToken[]
  idempotencyRecords      IdempotencyRecord[]

  @@map("users")
}

model MonthlySavingsSnapshot {
  id             String   @id @default(uuid())
  userId         String
  month          Int
  year           Int
  salaryIncome   Decimal  @db.Decimal(15, 2)
  otherIncome    Decimal  @db.Decimal(15, 2)
  expense        Decimal  @db.Decimal(15, 2)
  savings        Decimal  @db.Decimal(15, 2)
  formulaVersion Int      @default(4)
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@map("monthly_savings_snapshots")
}

enum WalletType {
  CASH
  BANK
  CREDIT_CARD
  E_WALLET
  SAVING
}

model Wallet {
  id                    String                 @id @default(uuid())
  userId                String
  name                  String
  type                  WalletType
  currency              String                 @default("VND")
  initialBalance        Decimal                @default(0.00) @db.Decimal(15, 2)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  sourceTransfers       WalletTransfer[]       @relation("SourceWalletRelation")
  destinationTransfers  WalletTransfer[]       @relation("DestinationWalletRelation")
  goalTransactions      GoalTransaction[]

  @@map("wallets")
}

enum CategoryType {
  INCOME
  EXPENSE
}

model Category {
  id                    String                 @id @default(uuid())
  userId                String?
  name                  String
  type                  CategoryType
  color                 String                 @default("#CCCCCC")
  icon                  String                 @default("tag")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  user                  User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]

  @@unique([userId, name, type])
  @@map("categories")
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

model Transaction {
  id              String          @id @default(uuid())
  userId          String
  walletId        String
  categoryId      String
  amount          Decimal         @db.Decimal(15, 2)
  type            TransactionType
  note            String?         @db.Text
  transactionDate DateTime
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  version         Int             @default(1)
  deletedAt       DateTime?
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet          Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  category        Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  attachments     Attachment[]

  @@map("transactions")
  @@index([userId, updatedAt])
}

model Budget {
  id         String    @id @default(uuid())
  userId     String
  categoryId String?
  amount     Decimal   @db.Decimal(15, 2)
  month      Int
  year       Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
  @@map("budgets")
}

model SavingGoal {
  id               String            @id @default(uuid())
  userId           String
  title            String
  targetAmount     Decimal           @db.Decimal(15, 2)
  currentAmount    Decimal           @default(0.00) @db.Decimal(15, 2)
  targetDate       DateTime
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalTransactions GoalTransaction[]

  @@map("saving_goals")
}

enum GoalTransactionType {
  DEPOSIT
  WITHDRAW
}

model GoalTransaction {
  id           String              @id @default(uuid())
  savingGoalId String
  walletId     String
  amount       Decimal             @db.Decimal(15, 2)
  type         GoalTransactionType
  createdAt    DateTime            @default(now())
  savingGoal   SavingGoal          @relation(fields: [savingGoalId], references: [id], onDelete: Cascade)
  wallet       Wallet              @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@map("goal_transactions")
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model RecurringTransaction {
  id                String       @id @default(uuid())
  userId            String
  walletId          String
  categoryId        String
  amount            Decimal      @db.Decimal(15, 2)
  type              CategoryType
  frequency         Frequency
  note              String?      @db.Text
  startDate         DateTime
  nextExecutionDate DateTime
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet            Wallet       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  category          Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@map("recurring_transactions")
}

enum NotificationType {
  BUDGET_ALERT
  BILL_REMINDER
  GOAL_COMPLETED
  RECURRING_TRANSACTION
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String           @db.Text
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique @map("token") @db.VarChar(64)
  tokenFamily String    @db.VarChar(36)
  deviceId    String?   @db.VarChar(191)
  deviceName  String?   @db.VarChar(191)
  platform    String    @default("web") @db.VarChar(16)
  appVersion  String?   @db.VarChar(32)
  timezone    String?   @db.VarChar(64)
  expiresAt   DateTime
  lastSeenAt  DateTime  @default(now())
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([tokenFamily])
  @@map("refresh_tokens")
}

model DeviceToken {
  id         String    @id @default(uuid())
  userId     String
  deviceId   String
  token      String    @unique @db.VarChar(255)
  platform   String    @db.VarChar(16)
  provider   String    @default("expo") @db.VarChar(16)
  appVersion String?   @db.VarChar(32)
  locale     String?   @db.VarChar(32)
  timezone   String?   @db.VarChar(64)
  isActive   Boolean   @default(true)
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId, provider])
  @@index([userId, isActive])
  @@map("device_tokens")
}

model IdempotencyRecord {
  id           String    @id @default(uuid())
  userId       String
  key          String    @db.VarChar(100)
  requestHash  String    @db.VarChar(64)
  status       String    @default("PENDING") @db.VarChar(16)
  statusCode   Int?
  responseBody Json?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model WalletTransfer {
  id                  String   @id @default(uuid())
  userId              String
  sourceWalletId      String
  destinationWalletId String
  amount              Decimal  @db.Decimal(15, 2)
  note                String?  @db.Text
  transferDate        DateTime
  createdAt           DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceWallet        Wallet   @relation("SourceWalletRelation", fields: [sourceWalletId], references: [id], onDelete: Restrict)
  destinationWallet   Wallet   @relation("DestinationWalletRelation", fields: [destinationWalletId], references: [id], onDelete: Restrict)

  @@map("wallet_transfers")
}

model Attachment {
  id            String       @id @default(uuid())
  transactionId String?
  url           String
  filename      String
  fileType      String
  fileSize      Int
  createdAt     DateTime     @default(now())
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("attachments")
}
